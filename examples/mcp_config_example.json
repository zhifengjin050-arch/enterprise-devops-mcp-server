{
  "mcpServers": {
    "enterprise-devops": {
      "command": "python",
      "args": [
        "scripts/run_devops_mcp.py"
      ],
      "cwd": "YOUR_PROJECT_PATH",
      "env": {
        "FASTMCP_SHOW_SERVER_BANNER": "false",
        "PYTHONUNBUFFERED": "1",
        "ENABLE_SECURITY": "true",
        "EXECUTE_TOOLS_ENABLED": "false",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}
