{
  "mcpServers": {
    "enterprise-devops": {
      "description": "Enterprise DevOps MCP Server",
      "command": "python",
      "args": [
        "scripts/run_devops_mcp.py"
      ],
      "cwd": "/absolute/path/to/enterprise-devops-mcp-server",
      "env": {
        "FASTMCP_SHOW_SERVER_BANNER": "false",
        "ENABLE_SECURITY": "true",
        "EXECUTE_TOOLS_ENABLED": "false",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}
