# ============================================================
# Enterprise DevOps MCP Server - Environment Example
# ============================================================
# Copy this file to .env and edit values for your environment:
#   cp .env.example .env
#
# NEVER commit real passwords, API keys, or production IPs.
# ============================================================

# ---- Basic ----
MCP_SERVER_NAME=Enterprise DevOps MCP Server
MCP_SERVER_VERSION=1.0.1

# ---- Security ----
API_KEY=YOUR_API_KEY
ENABLE_SECURITY=true

# ---- Tool whitelist (modules) ----
ALLOWED_TOOLS=system,docker,kubernetes,ssh

# ---- Dangerous command blacklist ----
BLOCKED_COMMANDS=rm -rf,shutdown,reboot,dd if,mkfs

# ---- Docker ----
# Linux/macOS: unix:///var/run/docker.sock
# Windows: leave empty or use Docker Desktop default (docker.from_env)
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_TLS_VERIFY=false
DOCKER_CERT_PATH=

# ---- Kubernetes ----
K8S_ENABLED=true
K8S_KUBECONFIG_PATH=
K8S_NAMESPACE=default

# ---- SSH defaults ----
SSH_DEFAULT_PORT=22
SSH_DEFAULT_TIMEOUT=30
# auto = 首次连接自动记录主机密钥（演示默认）；reject = 仅信任 known_hosts
SSH_HOST_KEY_POLICY=auto
# ssh_upload_file 本地文件大小上限（字节）
SSH_UPLOAD_MAX_BYTES=10485760

# Multi-server registry (JSON). Do NOT store passwords here.
# Prefer SSH keys. Pass password only at tool-call time if needed.
# SSH_SERVERS=[{"name":"example-server","host":"YOUR_SERVER_IP","port":22,"username":"YOUR_USERNAME"}]

# ---- Execute permissions (default OFF for safety) ----
EXECUTE_TOOLS_ENABLED=false
READ_ONLY_TOOLS=get_server_health,get_system_info,get_cpu_usage,get_memory_usage,get_disk_usage,list_processes,get_audit_logs,docker_list,docker_logs,k8s_get_pods,k8s_get_deployments,k8s_get_services,k8s_logs,ssh_check_connection
EXECUTE_TOOLS=docker_restart,ssh_execute_command,ssh_upload_file

# ---- Execute protection ----
# off | basic | strict
EXECUTE_PROTECTION_LEVEL=basic
EXECUTE_MAX_CALLS_PER_MINUTE=10

# ---- Audit ----
AUDIT_LOG_ENABLED=true
AUDIT_LOG_MAX_ENTRIES=1000

# ---- Logging ----
LOG_LEVEL=INFO
